{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "site",
  "readme": "README.md",
  "includeVersion": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "categorizeByGroup": true,
  "navigationLinks": {
    "GitHub": "https://github.com/dotcarls/fence.js",
    "npm": "https://www.npmjs.com/package/fence.js"
  },
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  }
}

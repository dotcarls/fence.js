{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dotcarls/fence.js/tools/schemas/work-item.schema.json",
  "title": "Work item front matter",
  "description": "One file per item under docs/work/items/FJ-NNNN-<slug>.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "status",
    "priority",
    "milestone",
    "created",
    "updated",
    "acceptance_criteria",
    "links"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^FJ-\\d{4}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "type": { "enum": ["epic", "story", "task", "bug", "spike", "decision", "release"] },
    "status": {
      "enum": ["backlog", "ready", "in-progress", "blocked", "review", "done", "cancelled"]
    },
    "priority": { "enum": ["p0", "p1", "p2", "p3"] },
    "milestone": {
      "type": ["string", "null"],
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$|^\\d+\\.x$",
      "description": "The release this item ships in (a semver version, a minor line like 2.x, or null when undecided)."
    },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "parent": { "type": ["string", "null"], "pattern": "^FJ-\\d{4}$" },
    "blocks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^FJ-\\d{4}$" },
      "uniqueItems": true
    },
    "blocked_by": {
      "type": "array",
      "items": { "type": "string", "pattern": "^FJ-\\d{4}$" },
      "uniqueItems": true
    },
    "blocked_reason": { "type": ["string", "null"] },
    "owner": {
      "type": ["string", "null"],
      "description": "Who must act: 'agent' or a person's name."
    },
    "labels": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "satisfied"],
        "properties": {
          "text": { "type": "string", "minLength": 3 },
          "satisfied": { "type": "boolean" },
          "evidence": {
            "type": ["string", "null"],
            "description": "Repository path (optionally #anchor), FJ-NNNN or ADR-NNNN. Required, and must resolve, when the item is done."
          },
          "verified_by": {
            "type": ["string", "null"],
            "description": "Test name, gate name, command, or 'human'."
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": { "type": "array", "items": { "type": "string" } },
        "docs": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "string" } },
        "adrs": { "type": "array", "items": { "type": "string", "pattern": "^ADR-\\d{4}$" } }
      }
    }
  }
}

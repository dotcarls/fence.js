{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dotcarls/fence.js/tools/schemas/doc.schema.json",
  "title": "Structured document front matter (docs/**/*.md other than work items, ADRs and the checkpoint)",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "doc_type", "status"],
  "properties": {
    "title": { "type": "string", "minLength": 3 },
    "doc_type": {
      "enum": [
        "index",
        "guide",
        "architecture",
        "toolchain",
        "governance",
        "design",
        "template",
        "release-notes"
      ]
    },
    "status": { "enum": ["draft", "review", "approved", "superseded", "living"] },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "feeds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ADR-NNNN, FJ-NNNN or document paths this document informs."
    }
  }
}

{
  "name": "fence.js",
  "version": "2.0.0-beta.1",
  "description": "Composable, portable validations: register named validation steps, derive and extend them, serialize them to JSON and run them anywhere the same names are registered",
  "keywords": [
    "validation",
    "validator",
    "composable",
    "builder",
    "serializable",
    "policy",
    "typescript"
  ],
  "homepage": "https://dotcarls.github.io/fence.js",
  "bugs": "https://github.com/dotcarls/fence.js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotcarls/fence.js.git"
  },
  "license": "MIT",
  "author": "Tim Carlson <tim.carlson@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "MIGRATING.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage docs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx test/bench/compare.bench.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run typecheck:examples && npm run examples && npm run check:package",
    "check:package": "publint && attw --pack . --profile esm-only",
    "docs": "typedoc",
    "examples": "tsx --tsconfig examples/tsconfig.json examples/run-all.ts",
    "prepare": "simple-git-hooks",
    "prepack": "rimraf dist && npm run build",
    "release": "release-it",
    "typecheck:examples": "tsc --noEmit -p examples"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.1",
    "globals": "^17.12.0",
    "joi": "^18.2.9",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "publint": "^0.3.24",
    "release-it": "^21.0.3",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "tinybench": "^6.2.0",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "validate.js": "^0.13.1",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run typecheck && npm test"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ],
    "*.{json,md,yml}": "prettier --write"
  }
}

{
  "name": "fence.js",
  "version": "2.0.1",
  "description": "Composable, portable validations: register named validation steps, derive and extend them, serialize them to JSON and run them anywhere the same names are registered",
  "keywords": [
    "validation",
    "validator",
    "composable",
    "builder",
    "serializable",
    "policy",
    "typescript"
  ],
  "homepage": "https://dotcarls.github.io/fence.js",
  "bugs": "https://github.com/dotcarls/fence.js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotcarls/fence.js.git"
  },
  "license": "MIT",
  "author": "Tim Carlson <tim.carlson@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "MIGRATING.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0 || >=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "adr": "tsx tools/gates/cli.ts adr",
    "bench": "tsx test/bench/compare.bench.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "check": "npm run verify:install && npm run gates && npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run examples && npm run check:package && npm run docs",
    "check:clean": "node scripts/check-clean.mjs",
    "check:package": "node scripts/check-package.mjs",
    "checkpoint": "tsx tools/gates/cli.ts checkpoint check",
    "clean": "rimraf dist coverage site",
    "docs": "typedoc",
    "examples": "npm run build && tsc --noEmit -p examples/tsconfig.dist.json && tsx --tsconfig examples/tsconfig.dist.json examples/run-all.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gates": "tsx tools/gates/cli.ts gates",
    "gates:fix": "tsx tools/gates/cli.ts gates --fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "prepare": "simple-git-hooks",
    "release": "release-it",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:install": "node scripts/verify-install.mjs",
    "work": "tsx tools/gates/cli.ts item"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.1",
    "globals": "^17.12.0",
    "joi": "^18.2.9",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "publint": "^0.3.24",
    "release-it": "^21.1.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.14.0",
    "tinybench": "^6.2.0",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "validate.js": "^0.13.1",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "simple-git-hooks": {
    "pre-commit": "bash tools/hooks/with-pinned-node.sh sh -c \"npx lint-staged && npm run gates\"",
    "pre-push": "bash tools/hooks/with-pinned-node.sh npm run check:clean"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ],
    "*.{json,md,yml}": "prettier --write"
  }
}
